# =====================================================================
#  Campagnes email — configuration
#
#  >>> LE CLIENT REMPLIT UNIQUEMENT LES DEUX PREMIÈRES VALEURS. <<<
#  Tout le reste est déjà prêt et ne doit pas être modifié sans raison.
# =====================================================================

# --- À remplir par le client -----------------------------------------

# Adresse Gmail qui enverra les campagnes
SMTP_USER=adresse@gmail.com

# Mot de passe d'application Google : 16 caractères, SANS espaces.
# À générer sur https://myaccount.google.com/apppasswords
# (la validation en deux étapes doit être activée sur le compte Google).
SMTP_PASSWORD=

# Nom affiché chez les destinataires (ex. « Boulangerie Dupont »)
FROM_NAME=Campagnes

# --- Réglages techniques ---------------------------------------------

# Adresse publique HTTPS de l'interface, utilisée dans les liens de
# désabonnement. Ex. : https://campagnes.exemple.fr
ROOT_URL=http://localhost:9000

# Nom du site affiché dans l'interface et les pages publiques
SITE_NAME=Campagnes email

# Compte d'administration de l'interface (à changer avant la mise en ligne)
ADMIN_USER=admin
ADMIN_PASSWORD=ChangezMoi2026!

# Base de données interne
DB_USER=listmonk
DB_PASSWORD=ChangezMoiAussi2026!
DB_NAME=listmonk

# Version de listmonk (image officielle). Toujours épingler une version.
LISTMONK_VERSION=v6.2.0

# Relevé automatique des rejets (bounces) par IMAP sur la même boîte Gmail.
# Laisser à false au départ : nécessite d'activer IMAP dans les paramètres
# Gmail du client. Passer à true une fois le reste validé.
BOUNCE_ENABLED=false
